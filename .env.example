# Required. Get one at https://console.anthropic.com/settings/keys
# Alternatively run `ant auth login` and leave this unset - the SDK picks up the profile.
ANTHROPIC_API_KEY=

# --- Model ---
# Any current Claude model id. Opus 5 is the default.
ATLAS_MODEL=claude-opus-5
# low | medium | high | xhigh | max  -- how hard the model thinks and works
ATLAS_EFFORT=high
# Hard ceiling on thinking + response tokens per turn
ATLAS_MAX_TOKENS=64000

# --- Guardrails ---
# Colon-separated directories the agent may read and write. Nothing outside these is reachable.
ATLAS_WORKSPACE_ROOTS=~/Desktop
# ask | allowlist | yolo   -- how run_command is gated
ATLAS_SHELL_MODE=ask
# Extra commands always allowed without a prompt (comma-separated, first word of the command)
ATLAS_SHELL_ALLOWLIST=ls,cat,head,tail,wc,grep,rg,find,file,stat,du,df,git,python3,python,pip,pytest,node,npm,jq,which,echo,pwd,date

# --- Memory ---
# Set to 0 to disable long-term vector memory entirely
ATLAS_MEMORY_ENABLED=1
# How many memories to auto-recall and inject per turn
ATLAS_MEMORY_TOP_K=5
# Cosine-similarity floor for auto-recall. Raise it if irrelevant memories leak in.
ATLAS_MEMORY_MIN_SCORE=0.15
# Keep only recalled memories scoring within this fraction of the best hit.
ATLAS_MEMORY_REL_RATIO=0.6
